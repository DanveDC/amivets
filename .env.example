# Database Configuration
POSTGRES_USER=vetuser
POSTGRES_PASSWORD=vetpass123
POSTGRES_DB=veterinaria_db
DATABASE_URL=postgresql://vetuser:vetpass123@db:5432/veterinaria_db

# Application Configuration
SECRET_KEY=your-super-secret-key-change-in-production
ENVIRONMENT=development
DEBUG=True

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email Configuration (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password

# Application Settings
APP_NAME=AmiVets - Sistema de Gestión Veterinaria
APP_VERSION=1.0.0

# Supabase — agendamiento público por QR
# Solo lo usa ese flujo: veterinarios visibles, horarios y citas del QR.
# El resto del sistema corre sobre el Postgres de DATABASE_URL.
#
# Ambos salen del panel del proyecto: Settings > API Keys.
#
# SUPABASE_SECRET_KEY es la clave `sb_secret_...` (antes `service_role`).
# IGNORA por completo el Row Level Security: acceso total a la base. Va solo
# acá, como variable de entorno del servidor. Nunca en el frontend ni
# commiteada. La clave PUBLICABLE (`sb_publishable_...`) es otra distinta y
# vive en index.html, que sí es pública por diseño.
#
# Las leen backend/app/routers/supabase_admin.py y sync_worker.py.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
